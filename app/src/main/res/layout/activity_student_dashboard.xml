<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".ui.student.dashboard.StudentDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header with gradient and text greetings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_student_header_gradient"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="@dimen/space_xxxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_student_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Studdy.TextAppearance.HeadlineLarge"
                        android:text="Hello, Student"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tv_student_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/Studdy.TextAppearance.BodySmall"
                        android:textColor="@color/brand_primary_surface"
                        tools:text="Enrollment: 2405112070013" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_qr_scan"
                    style="@style/Studdy.IconButton"
                    android:contentDescription="Scan QR to Join"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btn_refresh"
                    style="@style/Studdy.IconButton"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/btn_refresh"
                    android:src="@drawable/ic_refresh"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btn_logout"
                    style="@style/Studdy.IconButton"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/btn_sign_out"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- My Results Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_my_results"
            style="@style/Studdy.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_sm"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/page_padding_sm"
            android:layout_marginBottom="@dimen/space_sm"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/brand_primary"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_large">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_trophy"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/Studdy.TextAppearance.Title"
                            android:textStyle="bold"
                        android:text="My Results"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tv_completed_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textAppearance="@style/Studdy.TextAppearance.BodySmall"
                        android:text="0 exams completed"
                        android:textColor="@color/white" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TabLayout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            style="@style/Studdy.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:tabTextColor="?attr/colorOnSurfaceVariant"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabGravity="fill"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ongoing" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Filter Header Row (visible only in Ongoing tab) -->
        <LinearLayout
            android:id="@+id/scroll_filter_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/page_padding_sm"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/page_padding_sm"
            android:paddingBottom="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/Studdy.TextAppearance.Title"
                            android:textStyle="bold"
                android:text="Available Exams"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btn_filter"
                style="@style/Studdy.IconButton"
                android:contentDescription="Filter Exams"
                android:src="@drawable/ic_filter"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginStart="@dimen/page_padding_sm"
            android:background="@color/brand_secondary" />

        <!-- SwipeRefreshLayout and Recycler -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_exams"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="@dimen/page_padding_sm"
                    tools:listitem="@layout/item_student_exam_card" />

                <!-- Empty State view -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_xxl"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/iv_empty_state"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_book"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center"
                        android:textAppearance="@style/Studdy.TextAppearance.Body"
                        android:text="@string/no_exams_student"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
